[Unit]
Description=One-way copy of OneDrive to /srv/data/onedrive
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/data
OnFailure=restic-failure@%n.service

[Service]
Type=oneshot
User=sthewessen
Group=sthewessen
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
ExecStart=/usr/bin/rclone copy onedrive: /srv/data/onedrive --exclude ".*" --exclude ".*/**" --exclude "~$$*" --exclude "/Personal Vault/**" --log-level INFO
