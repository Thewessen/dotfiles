[Unit]
Description=restic backup (%i)
Documentation=man:restic(1)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/data
OnFailure=restic-failure@%n.service

[Service]
Type=oneshot
User=sthewessen
Group=sthewessen
EnvironmentFile=/etc/restic/%i.env
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
ExecStart=/usr/bin/restic backup $BACKUP_PATHS --retry-lock=1h --tag %i --exclude-caches --limit-upload $LIMIT_UPLOAD
