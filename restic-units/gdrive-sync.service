[Unit]
Description=One-way copy of Google Drive to /srv/data/documents/GDrive
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/data
OnFailure=restic-failure@%n.service

[Service]
Type=oneshot
User=sthewessen
Group=sthewessen
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
ExecStart=/usr/bin/rclone copy gdrive: /srv/data/documents/GDrive --exclude ".DS_Store" --log-level INFO
