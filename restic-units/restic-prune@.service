[Unit]
Description=restic forget + prune (%i)
After=network-online.target
Wants=network-online.target
OnFailure=restic-failure@%n.service

[Service]
Type=oneshot
User=sthewessen
Group=sthewessen
EnvironmentFile=/etc/restic/%i.env
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=4h
ExecStart=/usr/bin/restic forget --retry-lock=1h --tag %i $RETENTION --prune
