  "React File Component": {
    "prefix": ["react-file-functional-component", "rfc"],
    "body": [
      "import React from 'react';",
      "",
      "const ${1:ComponentName} = (${2:props}) => {",
      "\t${3:#:constants}",
      "",
      "\treturn (",
      "\t\t${0:TARGET}",
      "\t);",
      "};",
      "",
      "export default $1;"
    ],
    "description": "React functional component file"
  },
  "React Component with PropTypes": {
    "prefix": ["react-functional-component-proptypes", "rfcp"],
    "body": [
      "import React from 'react';",
      "import PropTypes from 'prop-types';",
      "",
      "const ${1:ComponentName} = (${2:props}) => {",
      "\t${3:#:constants}",
      "",
      "\treturn (",
      "\t\t${0:TARGET}",
      "\t);",
      "};",
      "",
      "$1.propTypes = {",
      "\t",
      "};",
      "",
      "$1.defaultProps = {",
      "\t",
      "};",
      "",
      "export default $1;"
    ],
    "description": "React functional component with PropTypes"
  },
  "PropTypes Array": {
    "prefix": ["proptype-array", "pa"],
