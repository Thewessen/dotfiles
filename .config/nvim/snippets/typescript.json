      "\t${1:#:do_stuff}",
      "} catch (${2:err}) {",
      "\t${3:#:handle_error}",
      "} finally {",
      "\t${4:#:do_more_stuff}",
      "};",
      "${0:TARGET}"
    ],
    "description": "Try-catch-finally block"
