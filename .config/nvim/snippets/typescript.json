  "Functional Component": {
    "prefix": ["functional-component", "cf"],
    "body": [
      "const ${1:MyComponent} = ${2:props} => {",
      "\t${3}",
      "",
      "\treturn (",
      "\t\t<>",
      "\t\t\t${4:#:JSX}",
      "\t\t</>",
      "\t);",
      "};",
      "${0:TARGET}"
    ],
    "description": "React functional component"
  },
  "Styled Component": {
    "prefix": ["styled-component", "cs"],
    "body": [
      "const ${1:MyStyledComponent} = styled.${2:div}((${3:props}) => `",
      "\t${4:#:styles}",
      "`);",
      "${0:TARGET}"
    ],
    "description": "Styled component"
  },
  "useState Hook": {
    "prefix": ["hook-state", "hs"],
    "body": [
      "const [${1:state}, ${2:setState}] = useState(${3:false});",
      "${0:TARGET}"
    ],
    "description": "useState hook"
  },
  "useEffect Hook": {
    "prefix": ["hook-effect", "he"],
    "body": [
      "useEffect(() => {",
      "\t${1:#:do_stuff}",
      "}, [${2:#:dependencies}]);",
      "${0:TARGET}"
    ],
    "description": "useEffect hook"
  },
