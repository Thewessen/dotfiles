{
  "TODO Comment": {
    "prefix": ["TODO", "td", "TD"],
    "body": [
      "// TODO: ${0:TARGET}"
    ],
    "description": "TODO comment"
  },
  "JSX TODO Comment": {
    "prefix": ["JSX-TODO", "rtd", "rto", "RTODO"],
    "body": [
      "{/* TODO: ${0:TARGET} */}"
    ],
    "description": "JSX TODO comment"
  },
  "Console Log": {
    "prefix": ["console.log", "cl", "log", "con"],
    "body": [
      "console.log(${0:TARGET});"
    ],
    "description": "Console log statement"
  },
  "Console Error": {
    "prefix": ["console.error", "ce", "error"],
    "body": [
      "console.error(${0:TARGET});"
    ],
    "description": "Console error statement"
  },
  "Console Warn": {
    "prefix": ["console.warn", "cw", "warn"],
    "body": [
      "console.warn(${0:TARGET});"
    ],
    "description": "Console warning statement"
  },
  "If Statement": {
    "prefix": ["if"],
    "body": [
      "if (${1:#:condition}) {",
      "\t${2:#:do_stuff}",
      "};",
      "${0:TARGET}"
    ],
    "description": "If statement"
  },
  "If Else": {
    "prefix": ["if-else", "ife"],
    "body": [
      "if (${1:#:condition}) {",
      "\t${2:#:do_stuff}",
      "} else {",
      "\t${3:#:do_more_stuff}",
      "};",
      "${0:TARGET}"
    ],
    "description": "If-else statement"
  },
  "If Else If": {
    "prefix": ["if-else-if", "ifei"],
    "body": [
      "if (${1:#:condition}) {",
      "\t${2:#:do_stuff}",
      "} else if (${3:#:condition}) {",
      "\t${4:#:do_more_stuff}",
      "};",
      "${0:TARGET}"
    ],
    "description": "If-else-if statement"
  },
  "For Loop": {
    "prefix": ["for"],
    "body": [
      "for (let ${1:i} = 0; $1 < ${2:#:Things}.length; $1 += ${3:1}) {",
      "\t${0:TARGET}",
      "}"
    ],
    "description": "For loop"
  },
  "For In Loop": {
    "prefix": ["for-in", "forin"],
    "body": [
      "for (const ${1:key} in ${2:obj}) {",
      "\tif ($2.hasOwnProperty($1)) {",
      "\t\t${0:TARGET}",
      "\t};",
      "};"
    ],
    "description": "For-in loop"
  },
  "For Of Loop": {
    "prefix": ["for-of", "forof"],
    "body": [
      "for (const ${1:value} of ${2:#:iterable}) {",
      "\t${0:TARGET}",
      "};"
    ],
    "description": "For-of loop"
  },
  "Arrow Function": {
    "prefix": ["arrow-function", "f"],
    "body": [
      "(${1:argument}) => {",
      "\t${2:#:do_stuff}",
      "}${0:TARGET}"
    ],
    "description": "Arrow function"
  },
  "Full Arrow Function": {
    "prefix": ["full-arrow-function", "fa"],
    "body": [
      "const ${1:#:functionName} = (${2:#:argument}) => {",
      "\t${3:#:do_stuff}",
      "};",
      "${0:TARGET}"
    ],
    "description": "Full arrow function declaration"
  },
  "Small Arrow Function": {
    "prefix": ["small-arrow-function", "fs"],
    "body": [
      "${1:#:argument} => ${0:#:TARGET}"
    ],
    "description": "Small arrow function"
  },
  "Promise Chain": {
    "prefix": ["promises", ".get", ".g"],
    "body": [
      ".get(${1:url})",
      ".then(resp => ${2:resp})",
      ".catch(err => ${3:err})",
      "${0:target}"
    ],
    "description": "Promise chain"
  },
  "Try Catch": {
    "prefix": ["try-catch", "tc"],
    "body": [
      "try {",
      "\t${1:#:do_stuff}",
      "} catch (${2:err}) {",
      "\t${3:#:handle_error}",
      "};",
      "${0:TARGET}"
    ],
    "description": "Try-catch block"
  },
  "Try Finally": {
    "prefix": ["try-finally", "tf"],
    "body": [
      "try {",
      "\t${1:#:do_stuff}",
